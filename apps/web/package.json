{
	"name": "web",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev --port 6005",
		"build": "next build",
		"start": "next start --port 6005",
		"lint": "eslint --max-warnings 0",
		"check-types": "next typegen && tsc --noEmit",
		"deploy:build": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build",
		"preview": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare preview",
		"deploy": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy --secrets-file .env.production",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"deploy:no-secrets": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy",
		"release": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy --secrets-file .env.production",
		"release:no-secrets": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy"
	},
	"dependencies": {
		"@repo/db": "workspace:*",
		"@repo/pricing": "workspace:*",
		"@repo/ui": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"framer-motion": "^12.23.26",
		"lucide-react": "^0.562.0",
		"next": "^16.2.12",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-icons": "^5.5.0",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-html": "^16.0.1"
	},
	"devDependencies": {
		"@opennextjs/cloudflare": "^1.20.2",
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^22.15.3",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"eslint": "^9.39.1",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.18",
		"typescript": "5.9.2",
		"wrangler": "^4.116.0"
	},
	"browserslist": [
		"chrome >= 90",
		"edge >= 90",
		"firefox >= 90",
		"safari >= 15",
		"ios_saf >= 15",
		"not dead",
		"not op_mini all"
	]
}
