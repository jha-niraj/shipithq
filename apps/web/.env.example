# ─────────────────────────────────────────────────────────────────────────────
# apps/web — ShipItHQ marketing site (shipithq.com)
#
# PURE PUBLIC MARKETING SURFACE. There is deliberately NO auth here:
#   - no @repo/auth dependency, no auth client, no session read, no auth cookies
#   - no email, no payments, no product UI
# Everything that needs a logged-in user lives on the app deploy (apps/main).
# The only database access is READ-ONLY landing stats plus writing newsletter /
# contact submissions.
#
# Copy to `.env` and fill real values.
#
# For the Cloudflare Workers deploy, `pnpm deploy` reads `.env.production` via
# `wrangler deploy --secrets-file .env.production` and uploads those as Worker secrets.
# Create that file with the same keys as below but production values. It is gitignored.
# (Use `pnpm deploy:nosecrets` to ship code without re-uploading secrets.)
# ─────────────────────────────────────────────────────────────────────────────

# ── App URLs ─────────────────────────────────────────────────────────────────
# This marketing site's own canonical public origin. Used for canonicals, OG tags,
# JSON-LD, sitemap.xml and robots.txt — set it to the exact production origin
# (including www or not) or you will publish self-conflicting canonical URLs.
NEXT_PUBLIC_WEB_URL="http://localhost:4100"

# The authenticated app deploy. Every "Get started" / "Sign in" CTA and every
# auth-owned path redirect points here.
NEXT_PUBLIC_APP_URL="http://localhost:4101"
NEXT_PUBLIC_HIRING_URL="http://localhost:6004"

# ── Database (landing stats + newsletter/contact capture) ────────────────────
# Neon serverless Postgres. Used only by the read-only platform-stats action and
# the newsletter/contact server actions. No user records are read or written here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
