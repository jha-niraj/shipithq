# ─────────────────────────────────────────────────────────────────────────────
# apps/main - ShipItHQ app (app.shipithq.com)  ·  dev port 3004
# Copy to `.env` and fill real values. Shared secrets (DB, auth) must match the
# other apps that talk to the same database / auth.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV="development"

# ── App / cross-app URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:4101"     # this app's own origin
NEXT_PUBLIC_WEB_URL="http://localhost:6005"      # marketing site (redirect target; apps/web dev port)
NEXT_PUBLIC_HIRING_URL="http://localhost:6004"   # the company app, for links in emails to companies (plan/inbox IN-7)

# NEXT_PUBLIC_APP_URL used to be listed here as "the app deploy (= this app)",
# which is what NEXT_PUBLIC_BASE_URL already is. Nobody ever set it, and five
# call sites interpolated it anyway - so the KnowMe share link, the API docs and
# the chat CTA all rendered the literal string "undefined/knowme/alice". It has
# no readers left; build shareable links with lib/urls.ts, which reads
# NEXT_PUBLIC_BASE_URL.

# ── Database (Neon serverless Postgres - shared @repo/db) ────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth (better-auth - shared @repo/auth) ───────────────────────────────────
BETTER_AUTH_URL="http://localhost:4101"
BETTER_AUTH_SECRET="generate-a-long-random-string"
# Set in production only, to the shared parent domain, to enable cross-subdomain
# session cookies (e.g. ".shipithq.com"). Leave empty on localhost.
AUTH_COOKIE_DOMAIN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_MAIL="ShipItHQ <noreply@shipithq.com>"

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Razorpay webhook signing secret. This is NOT the API key secret - it is set
# separately when you create the webhook in the Razorpay dashboard, under the
# URL <origin>/api/payments/webhook. Subscribe at least payment.captured,
# order.paid, payment.failed and refund.processed.
#
# Without it /api/payments/webhook refuses every request, and credits are only
# granted when the buyer's tab survives long enough to call verify.
RAZORPAY_WEBHOOK_SECRET=

# ── AI providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
# Model behind the in-app AI panel (/api/ai/chat). Optional - defaults to gpt-4o-mini.
OPENAI_CHAT_MODEL=""
ANTHROPIC_API_KEY=""
SARVAM_API_KEY=""
# Sarvam Voice Agents (plan/voice VO-3): live interviews. A DIFFERENT key from
# SARVAM_API_KEY - made in the Voice Agents dashboard, Settings > API Key. The ids
# are in the dashboard URL; APP_ID is the interviewer agent (VO-6).
SARVAM_AGENTS_API_KEY=""
SARVAM_AGENTS_ORG_ID=""
SARVAM_AGENTS_WORKSPACE_ID=""
SARVAM_AGENTS_APP_ID=""
EXA_API_KEY=""
FALAI_API_KEY=""
# OpenAI assistant IDs
PATHFINDER_ASSISTANT_ID=""
STUDY_PLAN_ASSISTANT_ID=""
AI_PROJECT_GENERATOR_ASSISTANT_ID=""

# ── Storage ──────────────────────────────────────────────────────────────────
# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional. A public bucket domain for profile pictures. Without it they are
# served through this app at /api/media/<key>, which works but routes image
# traffic through the Worker.
R2_PUBLIC_BASE_URL=""
R2_BUCKET_NAME=""
# Cloudinary

# ── Vector search (Cloudflare Vectorize) ─────────────────────────────────────
# In PRODUCTION none of these are needed: the app runs on Workers and reaches
# Vectorize over the VECTORIZE binding in wrangler.jsonc, with no credentials.
#
# They exist for `next dev`, which does not run inside a Worker and so has no
# binding to use. The REST fallback in utils/knowme/vector-db.ts needs:
#
#   CLOUDFLARE_API_TOKEN  a token with the "Vectorize:Edit" permission
#   VECTORIZE_INDEX_NAME  optional; defaults to shipithq-knowme
#
# ONE-TIME SETUP, before any of this works. The dimensions MUST be 1024 to match
# EMBEDDING_CONFIG in utils/knowme/embeddings.ts, and the metadata index is not
# optional - tenant isolation is a profileId filter, so without it every query
# quietly returns nothing:
#
#   npx wrangler vectorize create shipithq-knowme --dimensions=1024 --metric=cosine
#   npx wrangler vectorize create-metadata-index shipithq-knowme --property-name=profileId --type=string
#   npx wrangler vectorize create-metadata-index shipithq-knowme --property-name=sourceType --type=string
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
VECTORIZE_INDEX_NAME="shipithq-knowme"

# ── Workers ──────────────────────────────────────────────────────────────────
# Both are reached over SERVICE BINDINGS in production (WORKER, CODE_EXECUTOR in
# wrangler.jsonc), so these URLs only matter for local `next dev`, where there is
# no binding.

# apps/worker - background jobs. `wrangler dev` serves it on :8787.
WORKER_URL="http://localhost:8787"
# Former name for the same thing, still read as a fallback.
GENERATION_WORKER_URL=""

# apps/shipitworker - code execution (Cloudflare Container).
NEXT_PUBLIC_WORKER_URL="http://localhost:8080"
WORKER_API_URL="http://localhost:8080"

# Shared HMAC secret. MUST be byte-identical in apps/worker, apps/shipitworker
# and apps/uni, or every dispatch is rejected 401.
WORKER_SECRET=""

# ── GitHub integration + cron ────────────────────────────────────────────────
GITHUB_TOKEN=""
GITHUB_NIRAJ_JHA_TOKEN=""
CRON_SECRET=""
