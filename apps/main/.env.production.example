# ─────────────────────────────────────────────────────────────────────────────
# Main app — production environment
#
# Copy to `.env.production` (gitignored) and fill in. `pnpm deploy` uses it twice:
#
#     opennextjs-cloudflare build           ← Next reads .env.production here
#     wrangler deploy --secrets-file .env.production   ← uploads runtime secrets
#
# TWO KINDS OF VALUE, and the difference matters:
#
#   NEXT_PUBLIC_*   BUILD-TIME. Inlined into the client bundle by the build
#                   above. They are NOT secret and cannot be changed without
#                   rebuilding — setting one on the Worker afterwards has no
#                   effect on code already compiled into the bundle.
#   everything else RUNTIME. Uploaded as Worker secrets. Changing one only needs
#                   a redeploy, not a rebuild.
#
# `--secrets-file` is ADDITIVE: a secret already on the Worker but omitted here
# is left alone, not deleted. The trap is the opposite — a key present with an
# EMPTY value overwrites the live secret with an empty string. Delete the line
# rather than blanking it.
#
# `GOOGLE_SECRET_ID` is an accepted alias for `GOOGLE_CLIENT_SECRET`; set either.
# ─────────────────────────────────────────────────────────────────────────────

# ── App / cross-app URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://app.shipithq.com"
NEXT_PUBLIC_APP_URL="https://app.shipithq.com"
NEXT_PUBLIC_WEB_URL="https://www.shipithq.com"
NEXT_PUBLIC_HIRING_URL="https://hiring.shipithq.com"

# ── Database (Neon serverless Postgres — shared @repo/db) ────────────────────
DATABASE_URL=""

# ── Auth (better-auth — shared @repo/auth) ───────────────────────────────────
BETTER_AUTH_URL="https://app.shipithq.com"
BETTER_AUTH_SECRET=""
# Set in production only, to the shared parent domain, to enable cross-subdomain
# session cookies (e.g. ".shipithq.com"). Leave empty on localhost.
AUTH_COOKIE_DOMAIN=".shipithq.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_MAIL="ShipItHQ <noreply@shipithq.com>"

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Razorpay webhook signing secret. This is NOT the API key secret - it is set
# separately when you create the webhook in the Razorpay dashboard, under the
# URL <origin>/api/payments/webhook. Subscribe at least payment.captured,
# order.paid, payment.failed and refund.processed.
#
# Without it /api/payments/webhook refuses every request, and credits are only
# granted when the buyer's tab survives long enough to call verify.
RAZORPAY_WEBHOOK_SECRET=

# ── AI providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
# Model behind the in-app AI panel (/api/ai/chat). Optional — defaults to gpt-4o-mini.
OPENAI_CHAT_MODEL=""
ANTHROPIC_API_KEY=""
SARVAM_API_KEY=""
# Sarvam Voice Agents (plan/voice VO-3): live interviews. A DIFFERENT key from
# SARVAM_API_KEY - made in the Voice Agents dashboard, Settings > API Key. The ids
# are in the dashboard URL; APP_ID is the interviewer agent (VO-6).
SARVAM_AGENTS_API_KEY=""
SARVAM_AGENTS_ORG_ID=""
SARVAM_AGENTS_WORKSPACE_ID=""
SARVAM_AGENTS_APP_ID=""
EXA_API_KEY=""
FALAI_API_KEY=""
# OpenAI assistant IDs
# PATHFINDER_ASSISTANT_ID - moved to apps/worker/.env.production
# (verification generation runs on the worker since PF-W1)
STUDY_PLAN_ASSISTANT_ID=""
AI_PROJECT_GENERATOR_ASSISTANT_ID=""

# ── Storage ──────────────────────────────────────────────────────────────────
# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional. A public bucket domain for profile pictures. Without it they are
# served through this app at /api/media/<key>, which works but routes image
# traffic through the Worker.
R2_PUBLIC_BASE_URL=""
R2_BUCKET_NAME=""
# Cloudinary

# ── Vector search (Upstash) ──────────────────────────────────────────────────
UPSTASH_VECTOR_REST_URL=""
UPSTASH_VECTOR_REST_TOKEN=""

# ── Workers ──────────────────────────────────────────────────────────────────
# Both workers are reached over SERVICE BINDINGS (WORKER, CODE_EXECUTOR in
# wrangler.jsonc), so no URL is needed in production. The entries below are kept
# only as an escape hatch if a binding ever has to be bypassed.
WORKER_URL=""
GENERATION_WORKER_URL=""
NEXT_PUBLIC_WORKER_URL=""
WORKER_API_URL=""

# Shared HMAC secret. MUST be byte-identical in apps/worker, apps/shipitworker
# and apps/uni, or every dispatch is rejected 401.
WORKER_SECRET=""

# ── GitHub integration + cron ────────────────────────────────────────────────
GITHUB_TOKEN=""
GITHUB_NIRAJ_JHA_TOKEN=""
CRON_SECRET=""
