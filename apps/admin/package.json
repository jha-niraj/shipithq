{
	"name": "admin",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev --port 6002",
		"build": "next build",
		"start": "next start",
		"lint": "eslint --max-warnings 0",
		"check-nav": "node scripts/check-nav.mjs",
		"check-types": "next typegen && tsc --noEmit",
		"deploy:build": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build",
		"deploy": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy --secrets-file .env.production",
		"preview": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"deploy:no-secrets": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy",
		"release": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy --secrets-file .env.production",
		"release:no-secrets": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy"
	},
	"dependencies": {
		"@repo/ai": "workspace:*",
		"@repo/auth": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/email": "workspace:*",
		"@repo/exa": "workspace:*",
		"@repo/ui": "workspace:*",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.2.7",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.45.2",
		"framer-motion": "^12.23.26",
		"lucide-react": "^0.562.0",
		"next": "^16.2.12",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "^10.1.0",
		"recharts": "^3.6.0",
		"remark-gfm": "^4.0.1",
		"resend": "^6.6.0",
		"tailwind-merge": "^2.6.0",
		"zustand": "^5.0.9"
	},
	"devDependencies": {
		"@opennextjs/cloudflare": "^1.20.2",
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^22.15.3",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"eslint": "^9.39.1",
		"typescript": "5.9.2",
		"wrangler": "^4.116.0"
	}
}
