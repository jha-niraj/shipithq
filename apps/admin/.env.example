# ─────────────────────────────────────────────────────────────────────────────
# apps/admin - ShipItHQ internal admin console  ·  dev port 6002
# Copy to `.env` and fill real values. Everything under "Shared" MUST stay
# byte-identical to the other apps - a different BETTER_AUTH_SECRET means the
# shared session cookie fails to verify and the console cannot sign anyone in.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV="development"

# ── This app's own origin (matches `dev` in package.json) ───────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:6002"
NEXT_PUBLIC_ADMIN_URL="http://localhost:6002"

# ── Sibling app origins ───────────────────────────────────────────────────────
NEXT_PUBLIC_MAIN_URL="http://localhost:6001"
NEXT_PUBLIC_HIRING_URL="http://localhost:6004"
NEXT_PUBLIC_UNI_URL="http://localhost:6003"
NEXT_PUBLIC_WEB_URL="http://localhost:6005"

# ── Shared: database (@repo/db, neon-http) ───────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Shared: auth (@repo/auth, better-auth) ───────────────────────────────────
# BETTER_AUTH_URL is per-app; the secret and the OAuth clients are shared.
BETTER_AUTH_URL="http://localhost:6002"
BETTER_AUTH_SECRET="generate-a-long-random-string"
# Empty on localhost - there is no shared parent domain to scope the cookie to.
# In production this is ".shipithq.com", which is why the console has to gate
# on admin_access rather than "has a session" - see plan/admin/tasks.md ADM-1.
AUTH_COOKIE_DOMAIN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Shared: email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_MAIL="ShipItHQ Admin <noreply@shipithq.com>"

# ── Shared: storage (Cloudflare R2) ──────────────────────────────────────────
# Images go to R2, never Cloudinary - see the repo CLAUDE.md.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# ── Shared: cross-app + cron secrets ─────────────────────────────────────────
INTER_PLATFORM_SECRET=""
CRON_SECRET=""

# Background jobs (apps/worker): the company scrape started from Hiring >
# Companies > Drafts (plan/hiring-rounds HR-6). Must be byte-identical to
# apps/worker's WORKER_SECRET, or every dispatch is a 401.
WORKER_URL="http://localhost:8787"
WORKER_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# NOT YET USED BY THIS APP - names only, fill in when the feature that needs
# them lands.
# ─────────────────────────────────────────────────────────────────────────────


# AI (the console assistant - lib/ai/*, components/ai/*).
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL=""
ANTHROPIC_API_KEY=""

# Payments. Read-only payment screens don't need these; a refund action would.
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Analytics.
G_ANALYTICS_ID=""
