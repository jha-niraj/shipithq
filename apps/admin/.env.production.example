# ─────────────────────────────────────────────────────────────────────────────
# Admin console - production environment
#
# Copy to `.env.production` (gitignored) and fill in. `pnpm deploy` uses it twice:
#
#     opennextjs-cloudflare build           ← Next reads .env.production here
#     wrangler deploy --secrets-file .env.production   ← uploads runtime secrets
#
# TWO KINDS OF VALUE, and the difference matters:
#
#   NEXT_PUBLIC_*   BUILD-TIME. Inlined into the client bundle by the build
#                   above. They are NOT secret and cannot be changed without
#                   rebuilding - setting one on the Worker afterwards has no
#                   effect on code already compiled into the bundle.
#   everything else RUNTIME. Uploaded as Worker secrets. Changing one only needs
#                   a redeploy, not a rebuild.
#
# `--secrets-file` is ADDITIVE: a secret already on the Worker but omitted here
# is left alone, not deleted. The trap is the opposite - a key present with an
# EMPTY value overwrites the live secret with an empty string. Delete the line
# rather than blanking it.
#
# `GOOGLE_SECRET_ID` is an accepted alias for `GOOGLE_CLIENT_SECRET`; set either.
# ─────────────────────────────────────────────────────────────────────────────

# ── App / cross-app URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://admin.shipithq.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.shipithq.com"
NEXT_PUBLIC_MAIN_URL="https://app.shipithq.com"
NEXT_PUBLIC_HIRING_URL="https://hiring.shipithq.com"
NEXT_PUBLIC_UNI_URL="https://uni.shipithq.com"
NEXT_PUBLIC_WEB_URL="https://shipithq.com"

# ── Database (shared @repo/db) ───────────────────────────────────────────────
DATABASE_URL=""

# ── Auth (shared @repo/auth) ─────────────────────────────────────────────────
BETTER_AUTH_URL="https://admin.shipithq.com"
BETTER_AUTH_SECRET=""
AUTH_COOKIE_DOMAIN=".shipithq.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_MAIL="ShipItHQ Admin <noreply@shipithq.com>"

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
# Images go to R2, never Cloudinary - see the repo CLAUDE.md.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# ── Cross-app + cron secrets ──────────────────────────────────────────────────
INTER_PLATFORM_SECRET=""
CRON_SECRET=""

# Background jobs (apps/worker): the company scrape started from Hiring >
# Companies > Drafts (plan/hiring-rounds HR-6). Must be byte-identical to
# apps/worker's WORKER_SECRET, or every dispatch is a 401.
# In production the WORKER service binding is used, so WORKER_URL is not needed.
WORKER_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# NOT YET USED BY THIS APP - names only, fill in when the feature that needs
# them lands. Delete the line rather than deploying it empty (see the ADDITIVE
# note above) unless you want it live with an empty value.
# ─────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=""
OPENAI_CHAT_MODEL=""
ANTHROPIC_API_KEY=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
G_ANALYTICS_ID=""
