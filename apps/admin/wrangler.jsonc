{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shipithq-admin",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-11-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// Shared incremental-cache bucket. Create it once for the whole account:
	//     wrangler r2 bucket create shipithq-next-cache
	// NEXT_INC_CACHE_R2_PREFIX namespaces this app's entries so main/web/uni/hiring/admin
	// can all share the one bucket without colliding.
	"r2_buckets": [
		{
			"bucket_name": "shipithq-next-cache",
			"binding": "NEXT_INC_CACHE_R2_BUCKET"
		}
	],

	"vars": {
		"NEXT_INC_CACHE_R2_PREFIX": "shipithq-admin-cache"
	},

	// The background job worker (apps/worker), for the company scrape an admin
	// starts from Hiring > Companies > Drafts (plan/hiring-rounds HR-6). Same
	// binding name main uses; `lib/workers.ts` falls back to WORKER_URL locally.
	"services": [
		{
			"binding": "WORKER",
			"service": "shipithq-worker"
		}
	],

	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		}
	}
}
