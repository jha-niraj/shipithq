{
	"$schema": "node_modules/wrangler/config-schema.json",

	// Worker name - this is what shows in the Cloudflare dashboard.
	"name": "shipithq-hiring",

	// Entry point produced by `opennextjs-cloudflare build`.
	"main": ".open-next/worker.js",

	"compatibility_date": "2025-11-01",

	// nodejs_compat            - Node built-in polyfills (crypto, buffer, stream, ...)
	// global_fetch_strictly_public - fetch() behaves like the browser rather than
	//                            looping back into this Worker for same-origin URLs.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	// Hashed JS/CSS/font/image assets are served off Cloudflare's CDN, not the Worker.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// ── Incremental cache (R2) ────────────────────────────────────────────────
	// ONE-TIME SETUP before the first deploy (shared by every app in this monorepo,
	// so it only has to be created once):
	//     wrangler r2 bucket create shipithq-next-cache
	//
	// The binding name MUST be exactly NEXT_INC_CACHE_R2_BUCKET - that is the name
	// r2IncrementalCache in open-next.config.ts looks up. Without it, OpenNext has
	// nowhere to persist prerendered HTML/RSC and the Worker re-renders every page on
	// every request (`x-nextjs-cache: MISS` on every hit, slow cold-start TTFB).
	"r2_buckets": [
		{
			"bucket_name": "shipithq-next-cache",
			"binding": "NEXT_INC_CACHE_R2_BUCKET"
		}
	],

	// The background job worker (apps/worker), for "Generate with AI" aptitude
	// questions (plan/hiring-rounds HR-11). `lib/workers.ts` falls back to
	// WORKER_URL under `next dev`.
	"services": [
		{
			"binding": "WORKER",
			"service": "shipithq-worker"
		}
	],

	"vars": {
		// Namespaces this app's entries inside the shared bucket so the apps never
		// collide in the keyspace.
		"NEXT_INC_CACHE_R2_PREFIX": "shipithq-hiring-cache"
	},

	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		}
	}
}
