{
	"name": "hiring",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev --port 6004",
		"build": "next build",
		"start": "next start --port 6004",
		"lint": "eslint --max-warnings 0",
		"check-types": "next typegen && tsc --noEmit",
		"deploy:build": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build",
		"deploy": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy --secrets-file .env.production",
		"preview": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"deploy:no-secrets": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy",
		"release": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy --secrets-file .env.production",
		"release:no-secrets": "NODE_OPTIONS='--max-old-space-size=8192' opennextjs-cloudflare build && wrangler deploy"
	},
	"dependencies": {
		"@hookform/resolvers": "^3.10.0",
		"@repo/auth": "workspace:*",
		"better-auth": "^1.2.7",
		"@repo/db": "workspace:*",
		"@repo/email": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"@repo/ui": "workspace:*",
		"@tailwindcss/postcss": "^4.1.18",
		"axios": "^1.13.2",
		"bcryptjs": "^3.0.3",
		"date-fns": "^4.1.0",
		"framer-motion": "^12.23.26",
		"lucide-react": "^0.562.0",
		"next": "^16.2.12",
		"postcss": "^8.5.6",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.69.0",
		"react-icons": "^5.5.0",
		"recharts": "^3.6.0",
		"resend": "^4.0.0",
		"tailwindcss": "^4.1.18",
		"zod": "^3.24.3",
		"@aws-sdk/client-s3": "3.958.0",
		"@aws-sdk/s3-request-presigner": "3.958.0",
		"@excalidraw/excalidraw": "0.18.0",
		"@repo/ai": "workspace:*",
		"@repo/pricing": "workspace:*",
		"mammoth": "^1.11.0",
		"unpdf": "^1.6.2"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^22.15.3",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@opennextjs/cloudflare": "^1.20.2",
		"eslint": "^9.39.1",
		"typescript": "5.9.2",
		"wrangler": "^4.116.0"
	}
}
