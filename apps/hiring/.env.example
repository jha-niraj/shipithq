# ─────────────────────────────────────────────────────────────────────────────
# apps/hiring — ShipItHQ recruiter/company side (hiring.shipithq.com)  ·  port 3002
# Copy to `.env` and fill real values. DB + auth secrets must match the other apps.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV="development"

# ── App / cross-app URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3002"
NEXT_PUBLIC_HIRING_URL="http://localhost:3002"
NEXT_PUBLIC_MAIN_URL="http://localhost:6001"   # the student app, for links in emails to students (plan/inbox IN-7)

# ── Database (shared @repo/db) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth (shared @repo/auth) ─────────────────────────────────────────────────
BETTER_AUTH_URL="http://localhost:3002"
BETTER_AUTH_SECRET="generate-a-long-random-string"
AUTH_COOKIE_DOMAIN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_MAIL="ShipItHQ Hiring <noreply@shipithq.com>"

# ── Payments (Dodo — subscription plans) ─────────────────────────────────────
DODO_PAYMENTS_API_KEY=""
DODO_PRO_PRODUCT_ID=""
# Dodo dashboard > Webhooks > signing secret (whsec_...). Without it every webhook is refused.
DODO_PAYMENTS_WEBHOOK_KEY=""

# ── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""

# Marketing site: Terms and Privacy links on the auth screens (plan/auth AUTH-5).
NEXT_PUBLIC_WEB_URL="http://localhost:6005"

# ── Background jobs (apps/worker) ────────────────────────────────────────────
# "Generate with AI" for aptitude questions (plan/hiring-rounds HR-11). Must be
# byte-identical to apps/worker's WORKER_SECRET, or every dispatch is a 401.
WORKER_URL="http://localhost:8787"
WORKER_SECRET=""

# R2 (the same bucket and keys as the student app): private company documents for the AI (HA-13)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
