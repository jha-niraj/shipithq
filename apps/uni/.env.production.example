# ─────────────────────────────────────────────────────────────────────────────
# University platform — production environment
#
# Copy to `.env.production` (gitignored) and fill in. `pnpm deploy` uses it twice:
#
#     opennextjs-cloudflare build           ← Next reads .env.production here
#     wrangler deploy --secrets-file .env.production   ← uploads runtime secrets
#
# TWO KINDS OF VALUE, and the difference matters:
#
#   NEXT_PUBLIC_*   BUILD-TIME. Inlined into the client bundle by the build
#                   above. They are NOT secret and cannot be changed without
#                   rebuilding — setting one on the Worker afterwards has no
#                   effect on code already compiled into the bundle.
#   everything else RUNTIME. Uploaded as Worker secrets. Changing one only needs
#                   a redeploy, not a rebuild.
#
# `--secrets-file` is ADDITIVE: a secret already on the Worker but omitted here
# is left alone, not deleted. The trap is the opposite — a key present with an
# EMPTY value overwrites the live secret with an empty string. Delete the line
# rather than blanking it.
#
# `GOOGLE_SECRET_ID` is an accepted alias for `GOOGLE_CLIENT_SECRET`; set either.
# ─────────────────────────────────────────────────────────────────────────────

# ── App / cross-app URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://uni.shipithq.com"
NEXT_PUBLIC_UNI_URL="https://uni.shipithq.com"
NEXT_PUBLIC_MAIN_URL="https://app.shipithq.com"

# ── Database (shared @repo/db) ───────────────────────────────────────────────
DATABASE_URL=""

# ── Auth (shared @repo/auth) ─────────────────────────────────────────────────
BETTER_AUTH_URL="https://uni.shipithq.com"
BETTER_AUTH_SECRET=""
AUTH_COOKIE_DOMAIN=".shipithq.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_MAIL="ShipItHQ University <noreply@shipithq.com>"

# ── Payments (Dodo — subscription plans) ─────────────────────────────────────
DODO_PAYMENTS_API_KEY=""
DODO_UNI_STARTER_MONTHLY_ID=""
DODO_UNI_STARTER_YEARLY_ID=""
DODO_UNI_GROWTH_MONTHLY_ID=""
DODO_UNI_GROWTH_YEARLY_ID=""

# ── Code-execution worker ────────────────────────────────────────────────────
# apps/worker is reached over the WORKER service binding; no URL is needed.
WORKER_URL=""
WORKER_API_URL=""
NEXT_PUBLIC_WORKER_URL=""
WORKER_SECRET=""

# Marketing site: Terms and Privacy links on the auth screens.
NEXT_PUBLIC_WEB_URL="https://www.shipithq.com"
