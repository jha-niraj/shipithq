# ─────────────────────────────────────────────────────────────────────────────
# apps/uni — ShipItHQ university/institution side (uni.shipithq.com)  ·  port 3001
# Copy to `.env` and fill real values. DB + auth secrets must match the other apps.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV="development"

# ── App / cross-app URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_UNI_URL="http://localhost:3001"
NEXT_PUBLIC_MAIN_URL="http://localhost:3004"

# ── Database (shared @repo/db) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth (shared @repo/auth) ─────────────────────────────────────────────────
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_SECRET="generate-a-long-random-string"
AUTH_COOKIE_DOMAIN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_MAIL="ShipItHQ University <noreply@shipithq.com>"

# ── Payments (Dodo — subscription plans) ─────────────────────────────────────
DODO_PAYMENTS_API_KEY=""
DODO_UNI_STARTER_MONTHLY_ID=""
DODO_UNI_STARTER_YEARLY_ID=""
DODO_UNI_GROWTH_MONTHLY_ID=""
DODO_UNI_GROWTH_YEARLY_ID=""

# ── Workers ──────────────────────────────────────────────────────────────────
# apps/worker is reached over the WORKER service binding in production; this URL
# is only for local `next dev`, where there is no binding.
WORKER_URL="http://localhost:8787"
WORKER_API_URL="http://localhost:8787"
NEXT_PUBLIC_WORKER_URL="http://localhost:8080"
# Must be byte-identical to apps/worker's, or dispatch is rejected 401.
WORKER_SECRET=""

# Marketing site: Terms and Privacy links on the auth screens (plan/auth AUTH-5).
NEXT_PUBLIC_WEB_URL="http://localhost:6005"
