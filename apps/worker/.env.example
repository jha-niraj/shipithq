# Local development for the job worker: `wrangler dev` (serves on :8787).
#
# Wrangler reads this file automatically. Production values go in
# `.env.production`, which is what `pnpm release` uploads via --secrets-file.

DATABASE_URL=""
OPENAI_API_KEY=""

# Must match apps/main/.env exactly, or the app's signed job token is rejected.
WORKER_SECRET=""

# OpenAI Assistant id for Pathfinder verification (`asst_…`).
PATHFINDER_ASSISTANT_ID=""

# ElevenLabs, for the mock-interview and standup transcript jobs.
ELEVENLABS_API_KEY=""

# Exa, for the resume import job's LinkedIn / Twitter / portfolio scrapes.
# Without it, imports fail loudly rather than returning an empty resume.
EXA_API_KEY=""

# GitHub token for the import job's REST calls. Optional - unauthenticated
# GitHub allows 60 requests/hour, which is enough for development.
GITHUB_TOKEN=""

# Code executor (apps/shipitworker) over HTTP, for local development only.
# In production the CODE_EXECUTOR service binding in wrangler.jsonc is used and
# this can stay empty. Used by practice_tests_generate to validate tests.
EXECUTOR_URL=""
