{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shipithq-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-07",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},

	// ── One Durable Object per job type ───────────────────────────────────────
	// Each class owns the jobs of one type: `/start` persists the input and
	// schedules an Alarm, `alarm()` runs the work off the request path and writes
	// progress to `background_job`. The instance is addressed by jobId, so two
	// dispatches of the same job land on the same object and the second is
	// refused.
	//
	// The binding names here MUST match `JOB_BINDINGS` in src/env.ts. Adding a
	// job type means: the class, the entry in JOB_BINDINGS, a binding here, and a
	// migration tag below. All four or none.
	"durable_objects": {
		"bindings": [
			{ "name": "PROJECT_GENERATION", "class_name": "ProjectGeneration" },
			{ "name": "VERIFICATION_GENERATION", "class_name": "VerificationGeneration" },
			{ "name": "SPRINT_GENERATION", "class_name": "SprintGeneration" },
			{ "name": "PROJECT_QUIZ", "class_name": "ProjectQuiz" },
			{ "name": "STANDUP_VOICE", "class_name": "StandupVoice" },
			{ "name": "MOCK_CONVERSATION", "class_name": "MockConversation" },
			{ "name": "MOCK_FEEDBACK", "class_name": "MockFeedback" },
			{ "name": "RESUME_STRUCTURE", "class_name": "ResumeStructure" },
			{ "name": "RESUME_TAILOR", "class_name": "ResumeTailor" },
			{ "name": "COVER_LETTER", "class_name": "CoverLetter" },
			{ "name": "RESUME_ATS_SCORE", "class_name": "ResumeAtsScore" },
			{ "name": "COVER_LETTER_QUESTIONS", "class_name": "CoverLetterQuestions" },
			{ "name": "RESUME_IMPORT", "class_name": "ResumeImport" },
			{ "name": "SUBGOAL_GENERATION", "class_name": "SubGoalGeneration" },
			{ "name": "GOAL_CREATION", "class_name": "GoalCreation" },
			{ "name": "INTERVIEW_PREP_GENERATION", "class_name": "InterviewPrepGeneration" },
			{ "name": "PRACTICE_TESTS_GENERATE", "class_name": "PracticeTestsGenerate" },
			{ "name": "PRACTICE_MEMORY_UPDATE", "class_name": "PracticeMemoryUpdate" },
			{ "name": "PRACTICE_REFLECT", "class_name": "PracticeReflect" },
			{ "name": "SPRINT_QUIZ", "class_name": "SprintQuiz" },
			{ "name": "SPRINT_MOCK", "class_name": "SprintMock" },
			{ "name": "COMPANY_SCRAPE", "class_name": "CompanyScrape" }
		]
	},

	// This worker is deployed under a new script name (it was `shipithq-generation`
	// while it only did project generation), so its migration history starts here
	// rather than renaming the old classes. The old script keeps its own Durable
	// Objects until it is deleted - see DEPLOYMENT.md for the cutover order.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ProjectGeneration",
				"VerificationGeneration",
				"SprintGeneration",
				"ProjectQuiz",
				"StandupVoice",
				"MockConversation",
				"MockFeedback"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ResumeStructure"]
		},
		{
			// v3, not more classes on v2: migration tags are append-only. Editing a
			// tag that has already been applied leaves the deployed Worker and this
			// config disagreeing about what v2 created.
			"tag": "v3",
			"new_sqlite_classes": ["ResumeTailor", "CoverLetter"]
		},
		{
			// v4 for the same reason v3 was not folded into v2. See the note above.
			"tag": "v4",
			"new_sqlite_classes": ["ResumeAtsScore", "CoverLetterQuestions", "ResumeImport"]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": ["SubGoalGeneration"]
		},
		{
			"tag": "v6",
			"new_sqlite_classes": ["GoalCreation"]
		},
		{
			"tag": "v7",
			"new_sqlite_classes": ["InterviewPrepGeneration"]
		},
		{
			"tag": "v8",
			"new_sqlite_classes": ["PracticeTestsGenerate", "PracticeMemoryUpdate", "PracticeReflect"]
		},
		{
			// The workspace's Project AI (plan/project-workspace WS-15). A NEW tag:
			// tags are append-only once deployed.
			"tag": "v9",
			"new_sqlite_classes": ["ProjectAi"]
		},
		{
			// Sprint quizzes (plan/project-workspace WS-12). A NEW tag, as above.
			"tag": "v10",
			"new_sqlite_classes": ["SprintQuiz"]
		},
		{
			// Sprint mock interviews (plan/project-workspace WS-13). A NEW tag.
			"tag": "v11",
			"new_sqlite_classes": ["SprintMock"]
		},
		{
			// Project AI replies inline in the app since 2026-09-24
			// (plan/project-workspace WS-22), so its class is deleted. v9 stays:
			// tags are append-only, and a fresh deploy creates then deletes it.
			"tag": "v12",
			"deleted_classes": ["ProjectAi"]
		},
		{
			// Company profile scraping (plan/hiring-rounds HR-5). A NEW tag.
			"tag": "v13",
			"new_sqlite_classes": ["CompanyScrape"]
		}
	],

	// ── The code executor ─────────────────────────────────────────────────────
	// `practice_tests_generate` proves a generated test set by running the
	// reference solution in the real container before a problem is marked ready.
	// Same service apps/main binds as CODE_EXECUTOR; same shared-secret auth.
	// Under `wrangler dev` there is no binding and `EXECUTOR_URL` in .dev.vars is
	// used instead (plan/practice-dsa, PD-2).
	"services": [
		{
			"binding": "CODE_EXECUTOR",
			"service": "shipithq-shipitworker"
		}
	],

	// Non-secret vars only. Secrets (DATABASE_URL, OPENAI_API_KEY, WORKER_SECRET,
	// ELEVENLABS_API_KEY, PATHFINDER_ASSISTANT_ID, EXA_API_KEY,
	// FIRECRAWL_API_KEY) are uploaded by `pnpm release` from .env.production.
	"vars": {
		"NODE_ENV": "production"
	}
}
