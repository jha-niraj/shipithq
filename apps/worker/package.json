{
	"name": "worker",
	"version": "2.0.0",
	"description": "ShipItHQ background job worker (Cloudflare Worker + Durable Objects + Alarms)",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --secrets-file .env.production",
		"check-types": "tsc --noEmit",
		"cf-typegen": "wrangler types",
		"deploy:no-secrets": "wrangler deploy",
		"release": "wrangler deploy --secrets-file .env.production",
		"release:no-secrets": "wrangler deploy"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@paralleldrive/cuid2": "^2.2.2",
		"@repo/ai": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/exa": "workspace:*",
		"@repo/firecrawl": "workspace:*",
		"@repo/sarvamai": "workspace:*",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250510.0",
		"typescript": "5.9.2",
		"wrangler": "^4.116.0"
	}
}
