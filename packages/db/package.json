{
    "name": "@repo/db",
    "version": "1.0.0",
    "description": "Drizzle ORM client and schema for the monorepo",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./client": "./src/client.ts",
        "./schema": "./src/schema/index.ts",
        "./resume": "./src/resume.ts",
        "./ideas": "./src/ideas.ts",
        "./ideas-types": "./src/ideas-types.ts",
        "./hiring-send-types": "./src/hiring-send-types.ts",
        "./inbox-kinds": "./src/inbox-kinds.ts",
        "./notify": "./src/notify.ts",
        "./inbox": "./src/inbox.ts",
        "./inbox-view": "./src/inbox-view.ts",
        "./hiring-retention": "./src/hiring-retention.ts",
        "./hiring-purge": "./src/hiring-purge.ts",
        "./moderation": "./src/moderation.ts",
        "./assistant-store": "./src/assistant-store.ts",
        "./hiring-stats": "./src/hiring-stats.ts",
        "./report-reasons": "./src/report-reasons.ts",
        "./onboarding": "./src/onboarding-types.ts",
        "./project-setup": "./src/project-setup.ts",
        "./project-gates": "./src/project-gates.ts",
        "./practice": "./src/practice.ts",
        "./assistant": "./src/assistant-types.ts",
        "./profile-values": "./src/profile-values.ts",
        "./hiring-permissions": "./src/hiring-permissions.ts",
        "./hiring-defaults": "./src/seed/hiring-pipelines.ts"
    },
    "scripts": {
        "db:generate": "dotenv -e ../../apps/main/.env -- drizzle-kit generate",
        "db:migrate": "dotenv -e ../../apps/main/.env -- drizzle-kit migrate",
        "db:push": "dotenv -e ../../apps/main/.env -- drizzle-kit push",
        "db:studio": "dotenv -e ../../apps/main/.env -- drizzle-kit studio",
        "db:pull": "dotenv -e ../../apps/main/.env -- drizzle-kit introspect",
        "db:seed": "dotenv -e ../../apps/main/.env -- tsx src/seed/index.ts",
        "starters:check": "tsx src/seed/starters/verify.ts",
        "db:migrations": "dotenv -e ../../apps/main/.env -- tsx src/scripts/migrations.ts",
        "script": "dotenv -e ../../apps/main/.env -- tsx src/scripts/_run.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "@paralleldrive/cuid2": "^2.2.2",
        "drizzle-orm": "^0.45.2"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@types/node": "^22.15.3",
        "dotenv-cli": "^11.0.0",
        "drizzle-kit": "^0.31.0",
        "eslint": "^9.39.1",
        "marked": "^18.0.14",
        "tsx": "^4.23.12",
        "typescript": "5.9.2",
        "vitest": "^5.0.1"
    }
}
