{
    "name": "@repo/db",
    "version": "1.0.0",
    "description": "Drizzle ORM client and schema for the monorepo",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./client": "./src/client.ts",
        "./schema": "./src/schema/index.ts",
        "./resume": "./src/resume.ts",
        "./onboarding": "./src/onboarding-types.ts",
        "./practice": "./src/practice.ts"
    },
    "scripts": {
        "db:generate": "dotenv -e ../../apps/main/.env -- drizzle-kit generate",
        "db:migrate": "dotenv -e ../../apps/main/.env -- drizzle-kit migrate",
        "db:push": "dotenv -e ../../apps/main/.env -- drizzle-kit push",
        "db:studio": "dotenv -e ../../apps/main/.env -- drizzle-kit studio",
        "db:pull": "dotenv -e ../../apps/main/.env -- drizzle-kit introspect",
        "db:seed": "dotenv -e ../../apps/main/.env -- tsx src/seed/index.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "@paralleldrive/cuid2": "^2.2.2",
        "drizzle-orm": "^0.45.2"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@types/node": "^22.15.3",
        "dotenv-cli": "^11.0.0",
        "drizzle-kit": "^0.31.0",
        "eslint": "^9.39.1",
        "tsx": "^4.23.12",
        "typescript": "5.9.2"
    }
}
